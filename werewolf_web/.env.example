# LLM decision connection for every normal play interface.
# Copy this file to werewolf_web/.env. Never commit the filled-in file.
# The endpoint must support OpenAI-compatible Chat Completions.
# Native Anthropic/other provider protocols are not supported directly.

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.85

# Keyless local servers are supported. Failed preflight never falls back offline.
# Offline tests must be explicitly selected in the interface.
LLM_ENABLED=true

# Availability and spending controls; the model chooses, the engine adjudicates.
LLM_TIMEOUT_SECONDS=30
LLM_GAME_MAX_CALLS=240

# Optional Agent wrappers are configured in the process environment, not this file:
# WEREWOLF_MODEL_BACKEND=command (or api / codex)
# WEREWOLF_AGENT_COMMAND must be a JSON array; see docs/MODEL_CONNECTIONS.md.

# Optional. Set both only if the provider supports this request field.
# LLM_REASONING_EFFORT=medium
# LLM_REASONING_PARAM=reasoning_effort

# Used by python -m werewolf_web.run. The documented uvicorn command uses --port.
PORT=8000
